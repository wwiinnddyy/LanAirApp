{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wwiinnddyy/LanAirApp/main/airappmarket/schema/official-registry.schema.json",
  "title": "LanAirApp Official Plugin Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "sourceName", "defaultMarketManifestAssetName", "plugins"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceName": {
      "type": "string",
      "minLength": 1
    },
    "defaultMarketManifestAssetName": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.json$"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "capabilityHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktopComponents": {
          "$ref": "#/$defs/stringList"
        },
        "settingsSections": {
          "$ref": "#/$defs/stringList"
        },
        "exports": {
          "$ref": "#/$defs/stringList"
        },
        "messageTypes": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repositoryUrl"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "disabledReason": {
          "type": "string",
          "minLength": 1
        },
        "repositoryUrl": {
          "$ref": "#/$defs/url"
        },
        "marketManifestAssetName": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.json$"
        },
        "projectUrl": {
          "$ref": "#/$defs/url"
        },
        "readmeUrl": {
          "$ref": "#/$defs/url"
        },
        "homepageUrl": {
          "$ref": "#/$defs/url"
        },
        "iconUrl": {
          "$ref": "#/$defs/url"
        },
        "defaultMinHostVersion": {
          "$ref": "#/$defs/version"
        },
        "releaseAssetName": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.laapp$"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "capabilityHints": {
          "$ref": "#/$defs/capabilityHints"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": ["enabled"]
          },
          "then": {
            "required": ["disabledReason"]
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "assemblyName", "downloadUrl", "sha256", "packageSizeBytes"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "assemblyName": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.dll$"
        },
        "downloadUrl": {
          "$ref": "#/$defs/url"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "packageSizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
