{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wwiinnddyy/LanAirApp/main/airappmarket/schema/market-manifest.schema.json",
  "title": "LanMountainDesktop Plugin Market Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "manifest",
    "compatibility",
    "repository",
    "publication",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "optionalUrl": {
      "anyOf": [
        {
          "$ref": "#/$defs/url"
        },
        {
          "const": ""
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "assemblyName"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "assemblyName": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.dll$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "author",
        "version",
        "apiVersion",
        "sharedContracts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "apiVersion": {
          "$ref": "#/$defs/version"
        },
        "entranceAssembly": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.dll$"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "sharedContracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "releaseTag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "releaseAssetName": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.laapp$"
        },
        "releaseNotes": {
          "type": "string"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minHostVersion", "apiVersion"],
      "properties": {
        "minHostVersion": {
          "$ref": "#/$defs/version"
        },
        "apiVersion": {
          "$ref": "#/$defs/version"
        },
        "pluginApiVersion": {
          "$ref": "#/$defs/version"
        },
        "sharedContracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["in-proc", "isolated-background", "isolated-window"]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl"],
      "properties": {
        "iconUrl": {
          "$ref": "#/$defs/optionalUrl"
        },
        "projectUrl": {
          "$ref": "#/$defs/optionalUrl"
        },
        "readmeUrl": {
          "$ref": "#/$defs/optionalUrl"
        },
        "homepageUrl": {
          "$ref": "#/$defs/optionalUrl"
        },
        "repositoryUrl": {
          "$ref": "#/$defs/url"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "releaseNotes": {
          "type": "string"
        }
      }
    },
    "packageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "anyOf": [
        {
          "required": ["url"]
        },
        {
          "required": ["path"]
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["releaseAsset", "rawFallback", "workspaceLocal"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "assetName": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packageSizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "sizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "releaseTag": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseTag",
        "releaseAssetName",
        "sha256",
        "packageSizeBytes",
        "packageSources"
      ],
      "properties": {
        "releaseTag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "releaseAssetName": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.laapp$"
        },
        "downloadUrl": {
          "$ref": "#/$defs/url"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "md5": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "packageSizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "releaseNotes": {
          "type": "string"
        },
        "packageSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/packageSource"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sharedContracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "desktopComponents": {
          "$ref": "#/$defs/stringList"
        },
        "settingsSections": {
          "$ref": "#/$defs/stringList"
        },
        "exports": {
          "$ref": "#/$defs/stringList"
        },
        "messageTypes": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
